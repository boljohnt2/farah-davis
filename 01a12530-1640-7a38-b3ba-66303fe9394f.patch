+/* Design reference: Homepage-html.zip (Main.dc.html) — values kept verbatim for a pixel-faithful build. */
+body { margin: 0; background: #fff9f4; }
+
+/* Concept: the cover story. A glossy magazine for one woman. Giant Bodoni italics, a hero photo cut
+   like a window, color that arrives in full-bleed blocks, one rotating CTA badge and a confetti of
+   small shapes. No outlines, no shadows. Shapes are circles, arches and straight edges. */
+.fn {
+  --cobalt: #0047ab;
+  --royal: #4169e1;
+  --pink: #ff6fb8;
+  --blush: #ffe6ef;
+  --warm: #fff9f4;
+  --ink: #0b1030;
+  --focus: #ff6fb8;
+  --gutter: max(40px, calc((100vw - 1200px) / 2 + 40px));
+  --s-section: clamp(88px, 11vw, 144px);
+  --s-head: clamp(40px, 5vw, 72px);
+  font-family: var(--font-outfit), 'Outfit', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  font-weight: 400;
+  color: var(--ink);
+  background: var(--warm);
+  overflow-x: hidden;
+  -webkit-font-smoothing: antialiased;
+}
+.fn *, .fn *::before, .fn *::after { box-sizing: border-box; }
+:where(.fn) a { color: inherit; text-decoration: none; }
+:where(.fn) :is(h1, h2, h3, p, ul, figure, blockquote) { margin: 0; padding: 0; }
+:where(.fn) ul { list-style: none; }
+.fn img { display: block; }
+.fn :focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: 8px; }
+.light { --focus: #0047ab; }
+.final { --focus: #0b1030; }
+
+.wrap { max-width: 1200px; margin: 0 auto; padding-inline: 40px; position: relative; }
+
+/* Type */
+.serif { font-family: var(--font-bodoni), 'Bodoni Moda', 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 800; letter-spacing: -0.02em; }
+.body { font-size: 20px; line-height: 1.6; }
+.h2 { font-size: clamp(40px, 5.6vw, 84px); line-height: 0.98; text-wrap: balance; }
+
+/* Buttons: flat color, no outline or shadow */
+.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 13px 28px; white-space: nowrap; cursor: pointer; font-family: var(--font-outfit), 'Outfit', system-ui, sans-serif; font-weight: 600; font-size: 17px; line-height: 1.2; border-radius: 999px; border: 2px solid var(--warm); background: transparent; transition: background-color 0.25s, color 0.25s, border-color 0.25s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
+.fn a.btn { color: var(--warm); }
+.fn a.btn:hover { background: var(--pink); border-color: var(--pink); color: var(--ink); transform: translateY(-2px); }
+.fn a.btn-solid { background: var(--ink); border-color: var(--ink); color: var(--warm); font-size: 20px; padding: 18px 38px; min-height: 60px; }
+.fn a.btn-solid:hover { background: var(--warm); border-color: var(--warm); color: var(--ink); }
+.btn:active { transform: translateY(1px) scale(0.98); }
+.fn .arrowbtn { width: 60px; padding: 0; font-size: 24px; background: transparent; border-color: var(--warm); color: var(--warm); cursor: pointer; }
+.fn .arrowbtn:hover { background: var(--pink); border-color: var(--pink); color: var(--ink); }
+
+/* Hero */
+.hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); min-height: 800px; background: var(--cobalt); color: var(--warm); overflow: hidden; }
+.skip { position: absolute; left: 16px; top: -70px; z-index: 20; background: var(--pink); color: var(--ink); border-radius: 12px; padding: 10px 16px; font-weight: 600; }
+.skip:focus { top: 12px; }
+.nav { position: absolute; z-index: 6; top: 0; left: 0; right: 0; height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-inline: var(--gutter); }
+.brand { font-size: 32px; line-height: 1; }
+.navright { display: flex; align-items: center; gap: 36px; }
+.links { display: flex; gap: 30px; font-size: 16px; font-weight: 500; letter-spacing: 0.02em; }
+.links a { padding-block: 8px; border-bottom: 2px solid transparent; transition: border-color 0.2s; }
+.links a:hover { border-color: var(--pink); }
+.htext { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; gap: 36px; padding: 160px 90px 112px var(--gutter); }
+.h1 { font-size: clamp(48px, 6.6vw, 94px); line-height: 0.95; text-wrap: balance; }
+.al { position: relative; color: var(--pink); white-space: nowrap; }
+.al svg { position: absolute; left: 0; bottom: -0.14em; width: 100%; height: 0.24em; fill: none; stroke: var(--warm); stroke-width: 4; stroke-linecap: round; overflow: visible; }
+.lede { max-width: 25em; font-size: 22px; line-height: 1.5; font-weight: 300; }
+.seelink { align-self: flex-start; font-weight: 600; font-size: 18px; padding-bottom: 4px; border-bottom: 3px solid var(--pink); transition: color 0.2s; }
+.fn a.seelink:hover { color: var(--pink); }
+.hphoto { position: relative; margin-top: 88px; border-radius: 300px 0 0 0; overflow: hidden; background: var(--royal); }
+.hphoto img, .hphoto video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }
+.play { position: absolute; right: 44px; bottom: 44px; width: 96px; height: 96px; display: flex; align-items: center; justify-content: center; cursor: pointer; background: var(--warm); border: 0; border-radius: 50%; transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
+.play:hover { transform: scale(1.08); }
+.tri { width: 0; height: 0; margin-left: 8px; border-left: 24px solid var(--cobalt); border-top: 15px solid transparent; border-bottom: 15px solid transparent; }
+.badge { position: absolute; z-index: 5; left: calc(54% - 100px); bottom: 84px; width: 200px; height: 200px; display: block; border-radius: 50%; background: var(--pink); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
+.badge:hover { transform: scale(1.07) rotate(-6deg); }
+.badge .ring { position: absolute; inset: 0; width: 100%; height: 100%; }
+.badge .ring text { font-family: var(--font-outfit), 'Outfit', system-ui, sans-serif; font-weight: 700; font-size: 13.5px; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--ink); }
+.badge .core { position: absolute; left: 50%; top: 50%; width: 62px; height: 62px; margin: -31px 0 0 -31px; border-radius: 50%; background: var(--ink); color: var(--warm); display: flex; align-items: center; justify-content: center; font-size: 30px; line-height: 1; }
+.cf { position: absolute; pointer-events: none; z-index: 0; }
+.cf1 { width: 22px; height: 22px; border-radius: 50%; background: var(--pink); top: 17%; left: 46%; }
+.cf2 { width: 40px; height: 40px; border-radius: 50%; border: 4px solid var(--warm); top: 11%; right: 18%; }
+.cf3 { width: 14px; height: 46px; border-radius: 8px; background: var(--royal); top: 78%; left: 10%; transform: rotate(32deg); }
+.cf4 { width: 10px; height: 38px; border-radius: 8px; background: var(--pink); top: 70%; right: 22%; transform: rotate(-24deg); }
+.cf5 { width: 14px; height: 14px; border-radius: 50%; background: var(--warm); top: 40%; right: 8%; }
+.cf6 { width: 56px; height: 56px; border-radius: 50%; background: var(--royal); bottom: 6%; left: 40%; }
+@media (max-width: 960px) {
+  .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
+  .links { display: none; }
+  .navright { gap: 0; }
+  .nav { height: 76px; padding-inline: 20px; }
+  .htext { padding: 120px 20px 64px; }
+  .hphoto { margin-top: 0; border-radius: 180px 180px 0 0; aspect-ratio: var(--vr, 4 / 5); }
+  .badge { position: relative; left: auto; bottom: auto; justify-self: start; margin: 0 0 -100px 24px; width: 160px; height: 160px; }
+  .play { right: 24px; bottom: 24px; }
+}
+@media (max-width: 420px) { .brand { font-size: 25px; } .nav .btn { padding-inline: 16px; font-size: 15px; } }
+@media (prefers-reduced-motion: no-preference) {
+  .rise { animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; }
+  .rise.d2 { animation-delay: 0.1s; }
+  .rise.d3 { animation-delay: 0.2s; }
+  .rise.d4 { animation-delay: 0.3s; }
+  .al svg path { stroke-dasharray: 210; animation: draw 1.1s 0.7s ease-out both; }
+  .nav { animation: fadedown 0.9s 0.1s cubic-bezier(0.16, 1, 0.3, 1) both; }
+  .hphoto { animation: photoin 1.4s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both; }
+  .hphoto img, .hphoto video { animation: zoomout 2s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both; }
+  .badge { animation: pop 1s 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) both; }
+  .badge .ring { animation: spin 22s linear infinite; }
+  .rplay, .play { animation: pulse 2.6s ease-in-out infinite; }
+  @supports (animation-timeline: view()) {
+    .reveal { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 50%; }
+  }
+  .cf { animation: floaty 7s ease-in-out infinite; }
+  .cf2, .cf4 { animation-duration: 9s; animation-direction: reverse; }
+}
+@keyframes rise { from { opacity: 0; transform: translateY(36px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes fadedown { from { opacity: 0; translate: 0 -16px; } to { opacity: 1; translate: 0 0; } }
+@keyframes photoin { from { opacity: 0; clip-path: inset(0 0 0 45%); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
+@keyframes zoomout { from { scale: 1.18; } to { scale: 1; } }
+@keyframes pop { from { scale: 0; rotate: -120deg; } to { scale: 1; rotate: 0deg; } }
+@keyframes reveal { from { opacity: 0; translate: 0 64px; } to { opacity: 1; translate: 0 0; } }
+@keyframes pulse { 0%, 100% { scale: 1; } 50% { scale: 1.06; } }
+@keyframes draw { from { stroke-dashoffset: 210; } to { stroke-dashoffset: 0; } }
+@keyframes spin { to { transform: rotate(360deg); } }
+@keyframes floaty { 0%, 100% { translate: 0 0; } 50% { translate: 0 -16px; } }
+
+/* Ticker */
+.tick { background: var(--pink); color: var(--ink); overflow: hidden; padding-block: 22px; }
+.tick-track { display: flex; width: max-content; }
+.tick-set { display: flex; align-items: center; gap: 40px; padding-right: 40px; font-size: 34px; line-height: 1.2; white-space: nowrap; }
+.tick-set svg { width: 24px; height: 24px; flex: none; fill: var(--cobalt); }
+@media (prefers-reduced-motion: no-preference) { .tick-track { animation: tick 38s linear infinite; } }
+@keyframes tick { to { transform: translateX(-50%); } }
+@media (max-width: 560px) { .tick-set { font-size: 26px; gap: 28px; padding-right: 28px; } .tick-set svg { width: 18px; height: 18px; } }
+
+/* Coaching */
+.sec { padding-block: var(--s-section); }
+.sechead { display: flex; flex-direction: column; gap: 24px; max-width: 780px; }
+.sechead .h2 { color: var(--ink); }
+.panels { display: flex; min-height: 660px; }
+.panel { position: relative; flex: 1 1 0; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding: 56px 40px 64px; transition: flex-grow 0.9s cubic-bezier(0.65, 0, 0.35, 1), color 0.5s ease 0.2s; }
+.panels:hover .panel { flex-grow: 0.9; }
+.panels .panel:hover { flex-grow: 1.5; }
+.pin { width: 320px; max-width: 100%; display: flex; flex-direction: column; gap: 16px; position: relative; z-index: 1; }
+.panel h3 { font-size: clamp(40px, 4.2vw, 62px); line-height: 0.98; }
+.p1 { background: var(--pink); color: var(--ink); --ox: 40%; --oy: 28%; }
+.p2 { background: var(--cobalt); color: var(--warm); --ox: 40%; --oy: 22%; }
+.p3 { background: var(--royal); color: var(--warm); --ox: 50%; --oy: 42%; }
+.p2 .ring { position: absolute; top: -90px; right: -90px; width: 320px; height: 320px; border-radius: 50%; border: 4px solid var(--pink); }
+.p3 .half { position: absolute; top: 0; right: 0; width: 240px; height: 120px; border-radius: 0 0 240px 240px; background: var(--warm); }
+.p3 .dot { position: absolute; top: 150px; left: 44px; width: 26px; height: 26px; border-radius: 50%; background: var(--pink); }
+.pfull { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--ox) var(--oy); clip-path: circle(80px at var(--ox) var(--oy)); transition: clip-path 1.2s cubic-bezier(0.65, 0, 0.35, 1); will-change: clip-path; }
+.pring { position: absolute; z-index: 1; left: var(--ox); top: var(--oy); width: 196px; height: 196px; margin: -98px 0 0 -98px; border-radius: 50%; border: 3px solid var(--warm); pointer-events: none; transition: transform 1.2s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.5s ease; }
+.pscrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0; background: linear-gradient(to top, rgba(11, 16, 48, 0.9) 0%, rgba(11, 16, 48, 0.5) 42%, rgba(11, 16, 48, 0) 75%); transition: opacity 0.8s ease 0.2s; }
+.panel .pin { z-index: 2; }
+.panel:hover { color: var(--warm); }
+.panel:hover .pfull, .panel:focus-within .pfull { clip-path: circle(150% at var(--ox) var(--oy)); }
+.panel:hover .pscrim, .panel:focus-within .pscrim { opacity: 1; }
+.panel:hover .pring, .panel:focus-within .pring { transform: scale(2.6); opacity: 0; }
+@media (max-width: 1100px) { .panels { flex-direction: column; min-height: 0; } .panel { flex: none; min-height: 460px; transition: none; } .panels:hover .panel, .panels .panel:hover { flex-grow: 0; } .pin { width: 100%; max-width: 460px; } }
+@media (prefers-reduced-motion: reduce) { .panel, .pfull, .pring, .pscrim { transition: none; } }
+
+/* About */
+.about { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(56px, 7vw, 104px); align-items: center; }
+.aph { position: relative; padding-bottom: 20px; }
+.aph::before { content: ""; position: absolute; width: 76%; aspect-ratio: 1; border-radius: 50%; background: var(--pink); right: -10%; bottom: -4%; }
+.aph img { position: relative; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 25% 40%; border-radius: 999px 999px 0 0; }
+.aph figcaption { position: relative; margin-top: 22px; font-size: 34px; line-height: 1.1; color: var(--cobalt); }
+.copy { display: flex; flex-direction: column; gap: 28px; }
+.copy .h2 { font-size: clamp(38px, 4.6vw, 68px); }
+.quote { background: var(--royal); color: var(--warm); padding-block: var(--s-section); }
+.quote .big { font-size: clamp(38px, 6.2vw, 92px); line-height: 1.02; max-width: 15em; text-wrap: balance; }
+.quote .big b { font-weight: 800; text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 0.09em; text-underline-offset: 0.12em; }
+.quote .by { margin-top: 48px; font-size: 18px; font-weight: 600; letter-spacing: 0.04em; }
+@media (max-width: 960px) { .about { grid-template-columns: minmax(0, 1fr); gap: 64px; } .aph { max-width: 460px; } }
+
+/* Testimonials */
+.proof { background: var(--blush); }
+.tq { display: flex; flex-direction: column; gap: 28px; max-width: 900px; padding-block: 56px 64px; border-top: 2px solid var(--ink); }
+.tq:nth-child(even) { margin-left: auto; }
+.qm { font-size: 150px; line-height: 0.6; height: 64px; color: var(--pink); font-weight: 700; }
+.tq p { font-family: var(--font-outfit), 'Outfit', system-ui, sans-serif; font-size: clamp(28px, 3.5vw, 48px); line-height: 1.18; font-weight: 600; letter-spacing: -0.015em; color: var(--ink); text-wrap: pretty; }
+.tq figcaption { font-size: 16px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.5; }
+.tq figcaption b { font-weight: 700; }
+.tq figcaption span { display: block; font-weight: 400; color: var(--cobalt); }
+.proof .sechead { margin-bottom: var(--s-head); }
+
+/* More of me */
+.more { background: var(--cobalt); color: var(--warm); --focus: #ff6fb8; }
+.more .h2 { color: var(--warm); }
+.rows { margin-top: var(--s-head); border-bottom: 2px solid rgba(255, 249, 244, 0.35); }
+.row { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.8fr) auto; gap: 40px; align-items: center; padding-block: 44px; border-top: 2px solid rgba(255, 249, 244, 0.35); transition: padding-left 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
+.rhead { display: flex; align-items: center; gap: 28px; }
+.av { flex: none; width: 76px; height: 76px; border-radius: 50%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
+.row:hover .av { transform: scale(1.14) rotate(-8deg); }
+.row .rt { font-size: clamp(38px, 5.2vw, 78px); line-height: 0.95; transition: color 0.25s; }
+.row p { font-size: 19px; line-height: 1.5; max-width: 22em; }
+.row .go { display: inline-flex; align-items: center; gap: 14px; white-space: nowrap; font-weight: 600; font-size: 17px; }
+.row .go span { display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 50%; background: var(--pink); color: var(--ink); font-size: 22px; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s; }
+.row:hover { padding-left: 24px; }
+.row:hover .rt { color: var(--pink); }
+.row:hover .go span { transform: rotate(45deg); background: var(--warm); }
+@media (max-width: 860px) { .av { width: 60px; height: 60px; } .rhead { gap: 18px; } .row { grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 32px; } .row:hover { padding-left: 0; } }
+
+/* Kitchen */
+.kitchen { background: var(--warm); color: var(--ink); padding-block: var(--s-section); --focus: #0047ab; }
+.khead { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: var(--s-head); }
+.kitchen .sechead .h2 { color: var(--cobalt); }
+.fn .kitchen .arrowbtn { border-color: var(--ink); color: var(--ink); }
+.fn .kitchen .arrowbtn:hover { background: var(--pink); border-color: var(--pink); color: var(--ink); }
+.arrows { display: flex; gap: 14px; }
+.track { display: flex; gap: 28px; align-items: flex-start; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0 40px 32px var(--gutter); scroll-padding-left: var(--gutter); }
+.track::-webkit-scrollbar { display: none; }
+.reel { position: relative; flex: 0 0 auto; width: min(280px, 72vw); aspect-ratio: 9 / 16; border-radius: 999px 999px 28px 28px; overflow: hidden; scroll-snap-align: start; background: var(--royal); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
+.reel:nth-child(even) { margin-top: 44px; }
+.reel:hover { transform: translateY(-10px); }
+.reel img, .reel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+.rplay { position: absolute; left: 50%; bottom: 22px; width: 66px; height: 66px; margin-left: -33px; display: flex; align-items: center; justify-content: center; cursor: pointer; background: var(--pink); border: 0; border-radius: 50%; transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
+.rplay:hover { transform: scale(1.12); }
+.rplay .tri { border-left: 18px solid var(--ink); border-top-width: 11px; border-bottom-width: 11px; margin-left: 5px; }
+@media (prefers-reduced-motion: reduce) { .reel { transition: none; } }
+@media (max-width: 560px) { .track { padding-left: 20px; scroll-padding-left: 20px; } }
+
+/* Final */
+.final { background: var(--pink); color: var(--ink); padding-top: var(--s-section); }
+.final .mega { font-size: clamp(60px, 11.4vw, 176px); line-height: 0.88; letter-spacing: -0.03em; text-wrap: balance; }
+.fgrid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(48px, 6vw, 88px); align-items: start; padding-block: var(--s-head) var(--s-section); }
+.final .lead { font-size: 24px; line-height: 1.5; max-width: 22em; margin-bottom: 44px; }
+.fcta { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; }
+.fcta .note { font-size: 36px; line-height: 1; color: var(--cobalt); transform: rotate(-4deg); }
+.goes li { padding-block: 32px; border-top: 2px solid var(--ink); font-size: 19px; line-height: 1.5; }
+.goes li:last-child { border-bottom: 2px solid var(--ink); }
+.goes li b { display: block; font-family: var(--font-bodoni), 'Bodoni Moda', Georgia, serif; font-style: italic; font-weight: 800; font-size: 36px; line-height: 1.05; margin-bottom: 6px; letter-spacing: -0.01em; }
+@media (max-width: 960px) { .fgrid { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
+
+/* Footer */
+.footer { background: var(--ink); color: var(--warm); overflow: hidden; --focus: #ff6fb8; }
+.foot { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr)); gap: 40px; padding-block: 88px 56px; font-size: 17px; line-height: 1.7; }
+.foot .fbrand { display: block; font-size: 34px; line-height: 1; margin-bottom: 14px; }
+.foot h3 { font-size: 15px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 14px; color: var(--pink); }
+.foot ul { display: flex; flex-direction: column; gap: 6px; }
+.foot a { border-bottom: 2px solid transparent; transition: border-color 0.2s; }
+.foot a:hover { border-color: var(--pink); }
+.legal { padding-block: 0 24px; font-size: 16px; opacity: 0.8; }
+.wordmark { font-size: clamp(90px, 21vw, 330px); line-height: 0.8; color: var(--royal); white-space: nowrap; margin-top: 8px; margin-left: -0.02em; user-select: none; }
+@media (max-width: 960px) { .foot { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 560px) { .wrap { padding-inline: 20px; } .foot { grid-template-columns: minmax(0, 1fr); } }
